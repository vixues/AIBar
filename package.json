{
  "name": "aibar-workspace",
  "private": true,
  "type": "module",
  "license": "Apache-2.0",
  "workspaces": [
    "protocol",
    "core",
    "intent",
    "renderer-dom",
    "react",
    "devtools",
    "examples/*"
  ],
  "scripts": {
    "build": "npm run build -w @aibar/protocol && npm run build -w @aibar/core && npm run build -w @aibar/intent && npm run build -w @aibar/renderer-dom && npm run build -w @aibar/react && npm run build -w @aibar/devtools",
    "test": "vitest run",
    "lint": "eslint .",
    "attw": "npm run attw --workspaces --if-present",
    "publint": "npm run publint --workspaces --if-present",
    "changeset": "changeset",
    "capture:readme": "node scripts/capture-readme.mjs",
    "capture:gif": "node scripts/capture-playground-gif.mjs",
    "capture:gif:light": "node scripts/capture-playground-gif.mjs light"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "^0.18.0",
    "@changesets/cli": "^3.0.1",
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^10.8.1",
    "fast-check": "^4.0.0",
    "jsdom": "^30.0.1",
    "publint": "^0.3.24",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.5.0",
    "typescript": "^5.8.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.11"
  }
}
